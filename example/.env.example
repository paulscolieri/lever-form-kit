# Copy to .env.local for local work. Every variable is optional: with none set, the
# form still prices jobs and the API still answers, it just logs what it skipped.

# --- Email (Resend, https://resend.com) ---
# API key from the Resend dashboard.
RESEND_API_KEY=
# Sender address. The domain must be verified in Resend. Example: "Greenline Quotes <quotes@greenline.example>"
RESEND_FROM=
# Where the owner notification for each submission goes.
OWNER_EMAIL=owner@example.com

# --- Slack (optional) ---
# Incoming webhook URL for the channel that should see new quotes. Blank skips Slack.
SLACK_WEBHOOK_URL=

# --- Storage option A: Supabase ---
# Set both to store submissions in the "quotes" table. Create the table with supabase/schema.sql.
# The service role key bypasses row level security, so it stays server-side only. Never prefix it NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage option B: Google Sheet ---
# Web app URL from google-sheet/Code.gs. Used only when Supabase is not configured.
SHEET_WEBHOOK_URL=
